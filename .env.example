# ─────────────────────────────────────────────────────────────
# ContaGo — Variables de entorno (plantilla)
# Copiá este archivo como `.env` y completá los valores.
# NUNCA subas el .env real al repositorio.
# ─────────────────────────────────────────────────────────────

# ── Base de datos: Turso / libSQL (actual) ──────────────────
# En produccion, configura esta misma base remota en cada despliegue/dispositivo.
TURSO_DATABASE_URL="libsql://tu-db.turso.io"
TURSO_AUTH_TOKEN="tu-token-de-turso"
# Alternativa local: DATABASE_URL="file:./dev.db"

# ── Base de datos: Neon Postgres (migración futura) ─────────
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"  # para migraciones

# ── NextAuth ────────────────────────────────────────────────
NEXTAUTH_SECRET="genera-uno-con: openssl rand -base64 32"
# En produccion: URL HTTPS canonica del sitio; conserva NEXTAUTH_SECRET estable
# y con el mismo valor en todas las instancias para validar las sesiones.
NEXTAUTH_URL="http://localhost:3000"
# Opcional: clave independiente para proteger los codigos de verificacion.
# Si no se define, se usa NEXTAUTH_SECRET.
AUTH_CHALLENGE_PEPPER=""

# ── Login con Google ────────────────────────────────────────
# Redirect URI autorizado en Google Cloud: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Login con Microsoft (Microsoft Entra ID) ──────────────────
# Redirect URI autorizado: {NEXTAUTH_URL}/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
# Opcional: "common" permite cuentas personales y organizacionales.
AZURE_AD_TENANT_ID="common"

# ── Mercado Pago (vinculacion de cuenta) ────────────────────
# Credenciales de la app en el panel de desarrolladores de Mercado Pago.
# MP_REDIRECT_URI debe estar registrada en ese panel: {NEXTAUTH_URL}/api/mercadopago/callback
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_REDIRECT_URI="http://localhost:3000/api/mercadopago/callback"
# Clave propia para cifrar los tokens de Mercado Pago en la base (cualquier string largo).
MP_TOKEN_ENCRYPTION_KEY=""

# ── Email de autenticacion ───────────────────────────────────
# En desarrollo puede quedar en console; en produccion es obligatorio Resend.
AUTH_EMAIL_PROVIDER="console"
AUTH_EMAIL_FROM="ContaGo <cuentas@tu-dominio-verificado.com>"
RESEND_API_KEY=""

# ── Sentry (monitoreo de errores) ───────────────────────────
# Dashboard -> Settings -> Projects -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Opcional: token para subir source maps (Settings -> Auth Tokens)
SENTRY_AUTH_TOKEN=""

# ── Upstash Redis (rate limiting) ───────────────────────────
# Console de Upstash -> tu DB -> REST API; obligatorio en producción.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Cloudinary (imágenes de productos, si aplica) ───────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
