      contacts: [],
      areas: [],
      productos: MOCK.MOCK_PRODUCTOS,
      empleados: [],
      bienesDeUso: [],
      operatingModel: 'BOTH' as const,
    };
  }

  try {
    const databaseActions = await getDatabaseActions();
    return await databaseActions.getModalCatalogs();
  } catch (error) {
    if (isNextRedirectError(error)) {
      return emptyCatalogs();
    }
    throw error;
  }
}

