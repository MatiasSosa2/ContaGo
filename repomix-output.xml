    backgroundColor: 'transparent',
    grid: { top: 12, bottom: 36, left: 16, right: 16, containLabel: true },
    tooltip: {
      trigger: 'axis',
      backgroundColor: C.tooltip,
      borderColor: '#374151',
      borderWidth: 1,
      textStyle: { color: '#fff', fontSize: 11 },
