      type: 'INCOME' as const,
      subType: 'COBRO',
      amount: 52_000,
      currency: 'ARS',
      date: daysAgo(2),
      accountId: cash.id,
      categoryId: catIncome('')?.id ?? null,
      contactId: null,
    },
    {
      description: 'Pago alquiler oficina',
      type: 'EXPENSE' as const,
