                    <p className="text-[10px] font-semibold uppercase tracking-[0.2em] text-[#6B7280] dark:text-[#CBD5E1]">Resumen de Producto</p>
                    <span className="text-[10px] text-[#9CA3AF] dark:text-[#94A3B8]">{selectedProducto.unidad}</span>
