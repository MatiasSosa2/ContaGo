          const abs = Math.abs(v)
          if (abs >= 1_000_000) return `${v < 0 ? '-' : ''}$${(abs / 1_000_000).toFixed(1).replace('.0', '')}M`
          return `${v < 0 ? '-' : ''}$${abs.toLocaleString('es-AR')}`
        },
      },
    },
    series: [
      {
        name: 'Ingresos',
        type: 'bar',
        data: incomes,
        barMaxWidth: 28,
        itemStyle: { color: C.income, borderRadius: [4, 4, 0, 0] },
        emphasis: { itemStyle: { color: '#3A7D5C' } },
      },
      {
        name: 'Egresos',
        type: 'bar',
