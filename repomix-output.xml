    >
      {/* LOGOTIPO */}
      <div className={`h-[88px] flex items-center overflow-hidden transition-all duration-300 ${collapsed ? 'px-3 justify-center' : 'px-5'}`} style={{ borderBottom: '1px solid rgba(255,255,255,0.08)' }}>
        {collapsed ? (
          <Image
            src="/contago-mark.svg"
