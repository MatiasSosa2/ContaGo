              <stop offset="48%" stopColor="#C6E3D6" />
              <stop offset="52%" stopColor="#EACCA3" />
              <stop offset="100%" stopColor="#EACCA3" />
            </linearGradient>
          </defs>

          <path d="M0 0 H66 L52 42 L48 58 L34 100 H0 Z" fill="url(#balance-left-fill-light)" />
