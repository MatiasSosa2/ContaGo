// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// --- AUTHENTICATION (NextAuth.js Standard + Custom User Fields) ---

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Para logueo con contraseña
  defaultBusinessId String?
  lastLoginAt    DateTime?
  lastSecurityChallengeAt DateTime?
  
  accounts      AccountAuth[]
  sessions      Session[]
  emailChallenges EmailChallenge[]
  devices       UserDevice[]
  
  // Relación con Negocios (Un usuario puede estar en varios negocios)
  memberships   BusinessMember[]
  defaultBusiness Business? @relation("UserDefaultBusiness", fields: [defaultBusinessId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([defaultBusinessId])
}

model AccountAuth {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("Account_Auth_NextAuth") // Renombramos tabla para evitar conflicto conceptual con cuentas financieras
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model EmailChallenge {
  id         String   @id @default(uuid())
  userId     String?
  email      String
  purpose    String   // SIGNUP_VERIFY | SOCIAL_LOGIN_VERIFY | PASSWORD_RESET | RISK_CHALLENGE
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int      @default(0)
  maxAttempts Int     @default(5)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, purpose])
  @@index([userId, purpose])
  @@index([expiresAt])
}

model UserDevice {
  id                    String   @id @default(uuid())
  userId                String
  deviceFingerprintHash String
  label                 String?
  lastSeenAt            DateTime @default(now())
  trustedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceFingerprintHash])
  @@index([userId, lastSeenAt])
}

// --- BUSINESS LOGIC (Multi-Tenancy) ---

model Business {
  id          String   @id @default(uuid())
  name        String
  slug        String?  @unique // Para URLs amigables opcional
  currency    String   @default("ARS") // Moneda base del negocio
  operatingModel String @default("BOTH") // SERVICES | PRODUCTS | BOTH
  onboardingCompletedAt DateTime?

  members     BusinessMember[]

  // Tablas Financieras pertenecientes al negocio
  accounts       Account[]
  categories     Category[]
  subcategories  Subcategory[]
  cashTransfers  CashTransfer[]
  operaciones    Operacion[]
  transactions   Transaction[]
  contacts       Contact[]
  areas          AreaNegocio[]
  productos      Producto[]
  articulos      Articulo[]
  empleados      Empleado[]
  journalEntries JournalEntry[]
  bienesDeUso    BienDeUso[]
  defaultUsers   User[] @relation("UserDefaultBusiness")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BusinessMember {
  id         String   @id @default(uuid())
  role       String   @default("COLLABORATOR") // ADMIN | COLLABORATOR | VIEWER
  status     String   @default("ACTIVE") // ACTIVE | INVITED | SUSPENDED
  invitedAt  DateTime?
  acceptedAt DateTime?
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, businessId]) // Un usuario solo puede tener un rol por negocio
  @@index([userId, status])
  @@index([businessId, status])
}

// --- FINANCIAL MODELS (Scoped by Business) ---

model Account {
  id              String        @id @default(uuid())
  name            String
  description     String?
  type            String        // CASH | BANK | WALLET (tipo de cuenta física)
  currency        String        @default("ARS")
  currentBalance  Float         @default(0)

  // --- Motor contable ---
  // Tipo contable: ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
  contableType    String?       // null = pendiente de clasificar
  // Subtipo: CASH | BANK | RECEIVABLE | PAYABLE | SALES | EXPENSE_GEN | etc.
  subtype         String?
  // true = cuenta del sistema (CxC, CxP, Ventas, etc.) - oculta en formularios UX
  isSystemAccount Boolean       @default(false)

  transactions     Transaction[]
  journalLines     JournalLine[]
  transfersOut     CashTransfer[] @relation("TransferFrom")
  transfersIn      CashTransfer[] @relation("TransferTo")
  // Categorías que usan esta cuenta como su cuenta contable del sistema
  categoryContable Category[]    @relation("CategoryContableAccount")

  businessId       String
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Category {
  id           String        @id @default(uuid())
  name         String
  type         String
  transactions Transaction[]
  subcategories Subcategory[]

  // Cuenta contable del sistema asociada a esta categoría (INCOME/EXPENSE)
  contableAccountId String?   @unique
  contableAccount   Account?  @relation("CategoryContableAccount", fields: [contableAccountId], references: [id], onDelete: SetNull)

  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Operación de venta (luego también compra) con varios productos y pago dividido.
// Cada parte del pago —y cada cuota de la parte a crédito— es una Transaction con
// operacionId; los productos son OperacionItem y mueven stock.
model Operacion {
  id           String          @id @default(uuid())
  tipo         String          // VENTA | COMPRA
  date         DateTime        @default(now())
  description  String?
  subtotal     Float           // Σ cantidad × precio de los ítems
  descuento    Float           @default(0) // descuento general en monto
  total        Float           // subtotal − descuento

  contactId    String?
  contact      Contact?        @relation(fields: [contactId], references: [id])
  empleadoId   String?
  empleado     Empleado?       @relation(fields: [empleadoId], references: [id])

  items        OperacionItem[]
  transactions Transaction[]

  businessId   String
  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([businessId, date])
}

model OperacionItem {
  id             String    @id @default(uuid())
  operacionId    String
  operacion      Operacion @relation(fields: [operacionId], references: [id], onDelete: Cascade)
  productoId     String
  producto       Producto  @relation(fields: [productoId], references: [id])
  cantidad       Float
  precioUnitario Float
  subtotal       Float
  // CPP del producto al momento de la venta (base del CMV)
  costoUnitario  Float?

  @@index([operacionId])
}

// Cambio de caja: mueve plata entre dos cajas propias (puede cambiar de moneda).
// No es ingreso ni egreso: solo cambia el saldo de las dos cajas.
model CashTransfer {
  id            String   @id @default(uuid())
  date          DateTime @default(now())
  description   String?

  fromAccountId String
  fromAccount   Account  @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId   String
  toAccount     Account  @relation("TransferTo", fields: [toAccountId], references: [id])

  // Monto que sale (moneda de origen) y que entra (moneda de destino)
  amountFrom    Float
  amountTo      Float
  // Cotización en pesos por dólar, solo si cambia la moneda
  exchangeRate  Float?

  journalEntry  JournalEntry?

  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([businessId, date])
}

// Detalle opcional dentro de una categoría propia (ej. Sueldos › Sueldo Matías).
// La contabilidad usa la cuenta de la categoría padre.
model Subcategory {
  id           String        @id @default(uuid())
  name         String
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([categoryId])
}

model Transaction {
  id          String   @id @default(uuid())
  description String
  amount      Float
  currency    String   @default("ARS")
  exchangeRate Float?  @default(1) // Para convertir a moneda base si es diferente
  date        DateTime @default(now())
  type        String

  // Créditos y Deudas
  esCredito        Boolean   @default(false)
  estado           String    @default("COBRADO") // COBRADO | PAGADO | PENDIENTE | VENCIDO
  fechaVencimiento DateTime?

  // Datos Fiscales (Facturación)
  invoiceType      String?   // A, B, C, E, M, NotaCredito, etc.
  invoiceNumber    String?   // 0001-00001234
  invoiceFileUrl   String?   // Link a foto o PDF del comprobante

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  // Parte de una operación con varios productos / pago dividido
  operacionId   String?
  operacion     Operacion?   @relation(fields: [operacionId], references: [id], onDelete: SetNull)
  // Si es una cuota de la parte a crédito: número y total de cuotas
  cuotaNumero   Int?
  cuotasTotal   Int?

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  areaNegocioId String?
  areaNegocio   AreaNegocio? @relation(fields: [areaNegocioId], references: [id])

  // Subtipo de movimiento
  // SALE | SALE_PRODUCT | SALE_SERVICE | SALE_BIEN_USO | COBRO | COBRO_CREDITO | OTHER_INCOME | PURCHASE | PAGO
  subType String?

  // Producto (para ventas y compras)
  productoId     String?
  producto       Producto? @relation(fields: [productoId], references: [id])
  cantidad       Float?
  precioUnitario Float?

  // Bien de Uso (para venta de activos fijos)
  bienDeUsoId String?
  bienDeUso   BienDeUso? @relation(fields: [bienDeUsoId], references: [id])

  // Crédito original al que aplica este cobro (para COBRO_CREDITO total/parcial)
  linkedCreditoId String?
  linkedCredito   Transaction?  @relation("CreditoCobros", fields: [linkedCreditoId], references: [id])
  cobrosAplicados Transaction[] @relation("CreditoCobros")

  // Empleado (tracking de rendimiento)
  empleadoId String?
  empleado   Empleado? @relation(fields: [empleadoId], references: [id])

  // Motor contable: cada Transaction genera un JournalEntry
  journalEntry   JournalEntry?

  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, date, createdAt])
}

model Producto {
  id            String            @id @default(uuid())
  nombre        String
  descripcion   String?
  imagenUrl     String?
  // Tipo: MERCADERIA (con stock) | SERVICIO (sin stock)
  tipo          String            @default("MERCADERIA")
  categoria     String?
  marca         String?
  unidad        String            @default("unidad")
  metodoCosteo  String            @default("PROMEDIO") // PROMEDIO | FIFO | LIFO
  currency      String            @default("ARS")      // Moneda del producto
  precioVenta   Float             @default(0)
  precioCosto   Float             @default(0)
  stockActual   Float             @default(0)
  enTransito    Float             @default(0)
  alertaStock   Float?            // Umbral de stock bajo. Si es null, no alerta.
  // Variante de un artículo (ej. Remera Oversize · Negra · M). Null = producto suelto.
  articuloId    String?
  articulo      Articulo?         @relation(fields: [articuloId], references: [id])
  // JSON {"Talle":"M","Color":"Negra"}; null = sin atributos
  atributos     String?
  // true = precio propio de la variante; false = sigue el precio del artículo
  precioPropio  Boolean           @default(false)
  codigoBarras  String?
  activo        Boolean           @default(true)
  movimientos   MovimientoStock[]
  transactions  Transaction[]
  operacionItems OperacionItem[]

  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

// Bienes de Uso (activos fijos: maquinaria, vehículos, equipos, etc.)
model BienDeUso {
  id                    String   @id @default(uuid())
  nombre                String
  descripcion           String?
  categoria             String?
  marca                 String?
  valorAdquisicion      Float    @default(0)
  valorResidual         Float    @default(0)
  fechaAdquisicion      DateTime @default(now())
  vidaUtilMeses         Int?
  depreciacionAcumulada Float    @default(0)
  activo                Boolean  @default(true)
  transactions          Transaction[]

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, activo])
}

/// Artículo: agrupa variantes (talle, color, tamaño…). Cada variante es un Producto con su stock.
model Articulo {
  id           String     @id @default(uuid())
  nombre       String
  tipo         String     @default("MERCADERIA")
  categoria    String?
  subcategoria String?
  marca        String?
  unidad       String     @default("unidad")
  // Precio base: lo usan las variantes sin precio propio
  precioVenta  Float      @default(0)
  // JSON [{"nombre":"Talle","valores":["S","M"]}]
  atributos    String?
  // Foto achicada (data URL webp) y cuándo se cambió (para la caché del navegador)
  foto         String?
  fotoAt       DateTime?
  activo       Boolean    @default(true)
  productos    Producto[]

  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([businessId])
}

model MovimientoStock {
  id         String   @id @default(uuid())
  tipo       String   // ENTRADA | SALIDA | AJUSTE
  cantidad   Float
  precio     Float    @default(0)
  // SALIDA: costo promedio ponderado (CPP) del producto al momento de la salida.
  // CMV = cantidad × costoUnitario. Null en salidas viejas (se usa el costo actual).
  costoUnitario Float?
  motivo     String?
  fecha      DateTime @default(now())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model AreaNegocio {
  id           String        @id @default(uuid())
  nombre       String        
  descripcion  String?
  transactions Transaction[]

  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([nombre, businessId]) // El nombre es único SOLO dentro del mismo negocio
}

model Contact {
  id           String        @id @default(uuid())
  name         String
  phone        String?
  email        String?
  taxId        String?       // CUIT / CUIL / DNI del contacto
  type         String        // CLIENT, SUPPLIER
  transactions Transaction[]
  operaciones  Operacion[]

  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Empleado {
  id           String        @id @default(uuid())
  nombre       String
  cargo        String?
  email        String?
  phone        String?
  activo       Boolean       @default(true)
  transactions Transaction[]
  operaciones  Operacion[]

  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// --- MOTOR DE DOBLE PARTIDA ---

// Asiento contable (cabecera)
model JournalEntry {
  id            String        @id @default(uuid())
  date          DateTime      @default(now())
  description   String?

  // Relación 1:1 con la Transaction que lo originó
  transactionId String?       @unique
  transaction   Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  // O con el cambio de caja que lo originó
  cashTransferId String?      @unique
  cashTransfer   CashTransfer? @relation(fields: [cashTransferId], references: [id], onDelete: Cascade)

  lines         JournalLine[]

  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now())

  @@index([businessId, date])
  @@index([transactionId])
}

// Línea de asiento: DEBE / HABER
model JournalLine {
  id             String       @id @default(uuid())

  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])

  // Doble partida: siempre uno de los dos es > 0 y el otro es 0
  debit          Float        @default(0)  // DEBE
  credit         Float        @default(0)  // HABER

  description    String?

  createdAt      DateTime     @default(now())

  @@index([accountId])
  @@index([journalEntryId])
}

